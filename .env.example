# ─────────────────────────────────────────────────────────────
#  Telegram (обязательно)
# ─────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=

# Канал, на который нужно подписаться.
# Можно @username (для публичного канала) или числовой id вида -100123456789.
# ВАЖНО: бот должен быть администратором этого канала, иначе проверка подписки не работает.
CHANNEL_ID=

# Ссылка для кнопки «Подписаться».
# Если CHANNEL_ID = @username — можно оставить пустым (соберётся автоматически).
# Если CHANNEL_ID числовой — бот сам возьмёт ссылку через API (он админ канала).
# Для приватного канала можно указать инвайт-ссылку вручную.
CHANNEL_URL=

# ID администраторов через запятую (кому доступны /admin, /setfile, /setreminders, /reset).
# Свой id можно узнать у @userinfobot.
ADMIN_IDS=

# ─────────────────────────────────────────────────────────────
#  База данных (Postgres из docker-compose)
# ─────────────────────────────────────────────────────────────
# Пароль для встроенного Postgres. Задайте свой (любая строка без пробелов).
# Используется и контейнером Postgres, и строкой подключения бота.
POSTGRES_PASSWORD=change_me_strong_password

# (необязательно) пользователь и имя БД встроенного Postgres.
# POSTGRES_USER=postgres
# POSTGRES_DB=postgres

# Имя схемы под этот бот (создаётся автоматически, чужие схемы не трогаются).
DB_SCHEMA=sub_bot

# ─────────────────────────────────────────────────────────────
#  Напоминания неподписавшимся
# ─────────────────────────────────────────────────────────────
# Расписание по умолчанию. Кол-во значений = число напоминаний (число КОНЕЧНО).
# Суффиксы: m (минуты), h (часы), d (дни). Меняется на лету командой /setreminders.
REMINDER_INTERVALS=1h,24h,72h

# Как часто планировщик проверяет, кому пора напомнить / кто подписался (в минутах).
REMINDER_CHECK_INTERVAL_MIN=1

# ─────────────────────────────────────────────────────────────
#  Прочее
# ─────────────────────────────────────────────────────────────
# TTL кеша результата проверки подписки в секундах.
SUB_CACHE_TTL=60

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
#  Только для запуска БЕЗ Docker (python -m src.main).
#  В docker-compose эти значения подставляются автоматически — здесь не нужны.
# ─────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://postgres:change_me_strong_password@localhost:5432/postgres
# REDIS_URL=redis://localhost:6379/0
