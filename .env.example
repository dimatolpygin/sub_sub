# ─────────────────────────────────────────────────────────────
#  Telegram
# ─────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Канал, на который нужно подписаться.
# Можно @username (для публичного канала) или числовой id вида -100123456789.
# ВАЖНО: бот должен быть администратором этого канала, иначе проверка подписки не работает.
CHANNEL_ID=@my_channel

# Ссылка для кнопки «Подписаться». Если CHANNEL_ID = @username — можно не указывать,
# ссылка соберётся автоматически (https://t.me/my_channel).
# Для приватного канала укажите инвайт-ссылку.
CHANNEL_URL=

# ID администраторов через запятую (кому доступна команда /setfile).
# Свой id можно узнать у @userinfobot.
ADMIN_IDS=123456789

# ─────────────────────────────────────────────────────────────
#  База данных (существующий Postgres 16 в Docker)
# ─────────────────────────────────────────────────────────────
# DSN к уже работающему Postgres. Бот использует ОТДЕЛЬНУЮ схему и не трогает чужие таблицы.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Имя схемы под этот бот (создаётся автоматически).
DB_SCHEMA=sub_bot

# ─────────────────────────────────────────────────────────────
#  Redis (существующий Redis в Docker) — FSM и кеш подписок
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────
#  Напоминания неподписавшимся
# ─────────────────────────────────────────────────────────────
# Список интервалов от момента /start через запятую. Кол-во напоминаний = длина списка
# (число КОНЕЧНО, после последнего напоминания бот перестаёт беспокоить пользователя).
# Поддерживаемые суффиксы: m (минуты), h (часы), d (дни).
# Пример «1h,24h,72h» = напомнить через 1 час, через 24 часа и через 72 часа после старта.
REMINDER_INTERVALS=1h,24h,72h

# Как часто планировщик проверяет, кому пора напомнить / кто подписался (в минутах).
REMINDER_CHECK_INTERVAL_MIN=5

# ─────────────────────────────────────────────────────────────
#  Прочее
# ─────────────────────────────────────────────────────────────
# TTL кеша результата проверки подписки в секундах (чтобы не дёргать Telegram API лишний раз).
SUB_CACHE_TTL=60

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
